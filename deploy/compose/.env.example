# Settings of the Antimatter deployment (compose.yaml). Copy to .env, fill in, `chmod 600 .env`.
# Generate secrets with `openssl rand -hex 32` (hex: no characters that need quoting).
# The whole file is also passed to the antimatter container, which only reads MM_* variables.

# --- Site ---------------------------------------------------------------------------------------

# Domain users reach Antimatter at; the site URL is https://<domain>. Its DNS must point to this
# host.
ANTIMATTER_DOMAIN=chat.example.com

# Image: the stable antimatter, or antimatter-next for the features of the integration branches
# (GIFs and stickers, voice channels, polls, mail, calendar, notes, whiteboard). Pin a version
# tag (e.g. :1.2.3, or a sha-<commit> tag) instead of latest.
ANTIMATTER_IMAGE=ghcr.io/antimatterchat/antimatter:latest
#ANTIMATTER_IMAGE=ghcr.io/antimatterchat/antimatter-next:latest

# Optional parts, comma-separated: gifs (the GIF service, for antimatter-next) and acme (Let's
# Encrypt certificates instead of your own).
COMPOSE_PROFILES=
#COMPOSE_PROFILES=gifs,acme

TZ=UTC

# --- Database -----------------------------------------------------------------------------------

POSTGRES_USER=antimatter
POSTGRES_PASSWORD=
POSTGRES_DB=antimatter

# --- TLS (nginx) --------------------------------------------------------------------------------

# Your own certificate: put fullchain.pem (certificate + intermediates) and privkey.pem in
# ./certs.
TLS_CERTIFICATE=/etc/nginx/certs/fullchain.pem
TLS_CERTIFICATE_KEY=/etc/nginx/certs/privkey.pem
# With Let's Encrypt (profile acme), replace the two lines above with the paths certbot creates:
#TLS_CERTIFICATE=/etc/letsencrypt/live/chat.example.com/fullchain.pem
#TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/chat.example.com/privkey.pem

# E-mail Let's Encrypt sends expiry warnings to (profile acme; used by the first certbot command).
ACME_EMAIL=admin@example.com

# Host ports of nginx.
HTTP_PORT=80
HTTPS_PORT=443

# --- Calls --------------------------------------------------------------------------------------

# UDP and TCP port of the call media, published directly (not through nginx).
CALLS_PORT=8443
# Public IP address (or a hostname resolving to it) clients send call media to. Empty: found
# through STUN, which needs Internet access; set it on servers behind NAT or without Internet.
CALLS_ICE_HOST=

# --- GIF service (profile gifs) -----------------------------------------------------------------

# API key the GIFs plugin uses (required with the gifs profile).
GIFS_API_KEY=
# Upload key, to let users add GIFs and stickers from the picker; empty disables uploads.
GIFS_UPLOAD_KEY=
# Requests per second per client (API key + address); 0 disables the limit (see README.md).
GIFS_RATE_LIMIT=0

# --- Images of the other services ---------------------------------------------------------------

GIFS_IMAGE=ghcr.io/antimatterchat/antimatter-gifs:latest
POSTGRES_IMAGE=postgres:17-alpine
NGINX_IMAGE=nginx:stable-alpine
CERTBOT_IMAGE=certbot/certbot:latest

# --- Other server settings ----------------------------------------------------------------------

# Any MM_<SECTION>_<SETTING> variable sets that System Console setting (and locks it there).
# E-mail (notifications, invitations, password resets):
#MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=true
#MM_EMAILSETTINGS_FEEDBACKNAME=Antimatter
#MM_EMAILSETTINGS_FEEDBACKEMAIL=chat@example.com
#MM_EMAILSETTINGS_SMTPSERVER=smtp.example.com
#MM_EMAILSETTINGS_SMTPPORT=587
#MM_EMAILSETTINGS_CONNECTIONSECURITY=STARTTLS
#MM_EMAILSETTINGS_ENABLESMTPAUTH=true
#MM_EMAILSETTINGS_SMTPUSERNAME=chat@example.com
#MM_EMAILSETTINGS_SMTPPASSWORD=

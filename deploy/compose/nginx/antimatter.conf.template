# nginx in front of Antimatter: TLS termination, HTTP to HTTPS redirect, websockets.
#
# The nginx image renders this template to /etc/nginx/conf.d/default.conf at start, replacing
# the ANTIMATTER_DOMAIN, TLS_CERTIFICATE and TLS_CERTIFICATE_KEY placeholders with the values of
# the container's environment (set in compose.yaml from .env). nginx's own variables ($host...)
# are left alone.

upstream antimatter {
    server antimatter:8065;
    keepalive 64;
}

# Upgrade the connection for websockets (/api/v4/websocket and any plugin websocket), keep it
# alive towards Antimatter otherwise.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# Static files (web app bundles, plugin assets, emoji) that Antimatter marks as cacheable.
proxy_cache_path /var/cache/nginx/antimatter levels=1:2 keys_zone=antimatter_cache:10m
                 max_size=3g inactive=120m use_temp_path=off;

server_tokens off;

# Plain HTTP: ACME challenges, then everything goes to HTTPS.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${ANTIMATTER_DOMAIN};

    # Let's Encrypt HTTP-01 challenges (the certbot variant in compose.yaml writes them here).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # For the container's health check.
    location = /nginx-health {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${ANTIMATTER_DOMAIN};

    ssl_certificate     ${TLS_CERTIFICATE};
    ssl_certificate_key ${TLS_CERTIFICATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:AntimatterSSL:10m;
    ssl_session_tickets off;

    # Antimatter sets X-Content-Type-Options, Referrer-Policy, Permissions-Policy and
    # X-Frame-Options itself; only HSTS is up to the proxy. Raise max-age (e.g. 63072000) once
    # HTTPS works, and add "; includeSubDomains" only if every subdomain is on HTTPS.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Largest upload: keep it at least FileSettings.MaxFileSize (100 MB by default).
    client_max_body_size 100M;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_buffers 256 16k;
    proxy_buffer_size 16k;

    # The main websocket: long-lived, kept open by Antimatter's pings.
    location ~ ^/api/v[0-9]+/(users/)?websocket$ {
        client_body_timeout 60s;
        send_timeout 300s;
        lingering_timeout 5s;
        proxy_connect_timeout 90s;
        proxy_send_timeout 300s;
        proxy_read_timeout 90s;
        proxy_pass http://antimatter;
    }

    location / {
        proxy_read_timeout 600s;
        proxy_cache antimatter_cache;
        proxy_cache_revalidate on;
        proxy_cache_min_uses 2;
        proxy_cache_use_stale timeout;
        proxy_cache_lock on;
        proxy_pass http://antimatter;
    }

    # Optional: the GIF service's Tenor API and media under /gifs/,
    # for Tenor clients other than Antimatter or to let browsers load the media directly. Not
    # needed by the GIFs plugin, which reaches the service on the internal network. To enable it,
    # see "Exposing the GIF service" in README.md (nginx must join the gifs network, and the
    # service needs AM_GIFS_PUBLIC_URL and AM_GIFS_TRUST_PROXY).
    #
    # location /gifs/ {
    #     proxy_read_timeout 60s;
    #     proxy_pass http://antimatter-gifs:8080/;
    # }
}

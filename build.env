# Defaults for the build scripts and the GitHub workflow. Environment variables override them.

# Server source: GitHub repository and ref (branch, tag or commit).
SERVER_REPO=AntimatterChat/antimatter
SERVER_REF=antimatter
# Directory of the local server checkout, relative to LOCAL_ROOT (used with SOURCES=local).
SERVER_LOCAL=mattermost-nolicense

# Image to build.
IMAGE=ghcr.io/antimatterchat/antimatter
PLATFORMS=linux/amd64,linux/arm64

# Toolchain image used to compile the server and the plugins. Newer Go toolchains build older
# modules; GOTOOLCHAIN=auto fetches a newer one if a go.mod asks for it.
GO_IMAGE=golang:1.27-bookworm

# Heap for the webpack builds (the server web app needs several GB).
BUILD_NODE_OPTIONS=--max-old-space-size=6144

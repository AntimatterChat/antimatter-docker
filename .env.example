# Public URL users reach Antimatter at (put a TLS reverse proxy in front of port 8065).
SITE_URL=https://chat.example.org

# Database credentials (use a long random password).
POSTGRES_USER=antimatter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=antimatter

# Image to run.
ANTIMATTER_IMAGE=ghcr.io/antimatterchat/antimatter:latest

# Host ports.
HTTP_PORT=8065
CALLS_PORT=8443

TZ=UTC
